@page
@model NutriWeb.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div style="max-width: 450px; margin: 60px auto; padding: 0 20px;">
    <div class="glass-panel" style="padding: 40px 30px; background: rgba(12, 16, 23, 0.85); border-radius: 16px; border: 1px solid var(--glass-border);">
        
        <h2 style="color: var(--neon-cyan); text-align: center; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; font-size: 1.5rem;">
            Сброс пароля
        </h2>
        <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 25px;">
            Укажите Email, связанный с вашим аккаунтом. Мы отправим ссылку для сброса пароля.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" style="color: #ef4444; font-size: 0.85rem; margin-bottom: 15px;"></div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Input.Email" style="display: block; color: var(--accent-sage); font-size: 0.85rem; margin-bottom: 6px;">Ваш Email</label>
                <input asp-for="Input.Email" class="form-control" style="background: rgba(0,0,0,0.5); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; padding: 10px 14px; outline: none;" placeholder="user@example.com" />
                <span asp-validation-for="Input.Email" style="color: #ef4444; font-size: 0.78rem;"></span>
            </div>

            <button type="submit" class="btn-futuristic" style="width: 100%; padding: 12px; font-size: 0.95rem; font-weight: bold;">
                Отправить инструкцию
            </button>

            <div style="margin-top: 20px; text-align: center; border-top: 1px solid var(--glass-border); padding-top: 15px;">
                <a href="/Identity/Account/Login" style="color: var(--text-muted); font-size: 0.85rem; text-decoration: none;">
                    ← Вернуться к авторизации
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}