@page
@model NutriWeb.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Смена пароля";
}

<div style="max-width: 450px; margin: 60px auto; padding: 0 20px;">
    <div class="glass-panel" style="padding: 40px 30px; background: rgba(12, 16, 23, 0.85); border-radius: 16px; border: 1px solid var(--glass-border);">
        
        <h2 style="color: var(--neon-cyan); text-align: center; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; font-size: 1.5rem;">
            Новый пароль
        </h2>
        <p style="text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-bottom: 30px;">
            Введите ваш Email и придумайте новый надежный пароль.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" style="color: #ef4444; font-size: 0.85rem; margin-bottom: 15px;" role="alert"></div>
            
            <input asp-for="Input.Code" type="hidden" />

            <div style="margin-bottom: 20px;">
                <label asp-for="Input.Email" style="display: block; color: var(--accent-sage); font-size: 0.85rem; margin-bottom: 6px;">Ваш Email</label>
                <input asp-for="Input.Email" class="form-control" style="background: rgba(0,0,0,0.5); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; padding: 10px 14px; outline: none;" placeholder="user@example.com" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" style="color: #ef4444; font-size: 0.78rem;"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="Input.Password" style="display: block; color: var(--accent-sage); font-size: 0.85rem; margin-bottom: 6px;">Новый пароль</label>
                <input asp-for="Input.Password" type="password" class="form-control" style="background: rgba(0,0,0,0.5); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; padding: 10px 14px; outline: none;" placeholder="••••••••" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.Password" style="color: #ef4444; font-size: 0.78rem;"></span>
            </div>

            <div style="margin-bottom: 25px;">
                <label asp-for="Input.ConfirmPassword" style="display: block; color: var(--accent-sage); font-size: 0.85rem; margin-bottom: 6px;">Подтвердите пароль</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" style="background: rgba(0,0,0,0.5); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px; padding: 10px 14px; outline: none;" placeholder="••••••••" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.ConfirmPassword" style="color: #ef4444; font-size: 0.78rem;"></span>
            </div>

            <button type="submit" class="btn-futuristic" style="width: 100%; padding: 12px; font-size: 1rem; font-weight: bold;">
                Изменить пароль
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}