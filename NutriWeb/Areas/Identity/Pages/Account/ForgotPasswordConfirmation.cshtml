@page
@{
    ViewData["Title"] = "Подтверждение сброса пароля";
}

<div style="max-width: 450px; margin: 60px auto; padding: 0 20px;">
    <div class="glass-panel" style="padding: 40px 30px; background: rgba(12, 16, 23, 0.85); border-radius: 16px; border: 1px solid var(--glass-border); text-align: center;">
        
        <div style="font-size: 2.5rem; margin-bottom: 10px;">📩</div>
        <h2 style="color: var(--neon-cyan); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; font-size: 1.4rem;">
            Инструкция отправлена
        </h2>
        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 25px;">
            Если указанный e-mail зарегистрирован в системе, мы направили на него письмо со ссылкой для сброса пароля.
        </p>

        <a href="/Identity/Account/Login" class="btn-futuristic" style="display: inline-block; padding: 10px 20px; font-size: 0.88rem; text-decoration: none;">
            Вернуться на страницу входа
        </a>

    </div>
</div>