@using Microsoft.AspNetCore.Identity
@using NutriWeb.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav d-flex flex-row gap-3 align-items-center mb-0" style="list-style: none; margin: 0; padding: 0;">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-light" href="/Account/Profile" style="color: #fff; text-decoration: none;">
            Привет, @User.Identity?.Name!
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit" class="btn btn-link text-light text-decoration-none p-0" style="color: var(--text-muted); border: none; background: none; cursor: pointer;">
                Выйти
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register" style="color: #fff; text-decoration: none;">
            Регистрация
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login" style="color: #fff; text-decoration: none;">
            Войти
        </a>
    </li>
}
</ul>