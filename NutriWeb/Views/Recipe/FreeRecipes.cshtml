@model List<NutriWeb.Models.Recipe>
@{
    ViewData["Title"] = "Бесплатные рецепты";
}

<style>
    .recipe-card-img {
        width: 100%;
        height: 190px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 15px;
        display: block;
        border: 1px solid var(--glass-border);
    }

    .recipe-grid-3-col {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 25px;
    }

    @@media (max-width: 900px) {
        .recipe-grid-3-col { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 600px) {
        .recipe-grid-3-col { grid-template-columns: 1fr; }
    }
</style>

<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">
    <div style="text-align: center; margin-bottom: 45px;">
        <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid #10b981; padding: 6px 18px; border-radius: 20px; font-size: 0.82rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">
            Открытая база знаний
        </span>
        <h1 style="color: var(--neon-cyan); text-transform: uppercase; letter-spacing: 1px; margin-top: 15px;">
            Бесплатные авторские рецепты
        </h1>
        <p style="color: var(--text-muted); font-size: 1rem; max-width: 700px; margin: 0 auto;">
            Доступны всем пользователям без обязательной подписки. Полный расклад КБЖУ, список ингредиентов и пошаговая технология приготовления.
        </p>
    </div>

    <div class="recipe-grid-3-col">
        @foreach (var recipe in Model)
        {
            <div class="glass-panel" style="padding: 22px; background: rgba(12, 16, 23, 0.7); display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                    {
                        <img src="@recipe.ImageUrl" alt="@recipe.Title" class="recipe-card-img" />
                    }

                    <h3 style="margin-top: 0; color: #ffffff; font-size: 1.1rem; line-height: 1.3;">@recipe.Title</h3>
                    <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.4; margin-bottom: 15px;">@recipe.Description</p>
                </div>

                <div>
                    <hr style="border-color: var(--glass-border); margin: 12px 0;" />

                    <h4 style="color: var(--accent-sage); margin-bottom: 6px; font-size: 0.85rem;">Состав и КБЖУ:</h4>
                    <p style="color: var(--text-primary); font-size: 0.82rem; white-space: pre-line; margin-bottom: 12px; line-height: 1.5;">@recipe.Ingredients</p>

                    <h4 style="color: var(--accent-sage); margin-bottom: 6px; font-size: 0.85rem;">Приготовление:</h4>
                    <p style="color: var(--text-primary); font-size: 0.82rem; white-space: pre-line; margin: 0; line-height: 1.5;">@recipe.CookingSteps</p>
                </div>
            </div>
        }
    </div>
</div>