@model NutriWeb.Models.LoginViewModel
@{
    ViewData["Title"] = "Вход в аккаунт";
}

<div style="max-width: 450px; margin: 60px auto; padding: 0 20px;">
    <div class="glass-panel" style="padding: 35px; background: rgba(12, 16, 23, 0.7);">
        <h2 style="text-align: center; color: var(--neon-cyan); margin-top: 0; text-transform: uppercase; letter-spacing: 1px;">
            Вход в систему
        </h2>
        <p style="text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 25px;">
            Авторизуйтесь для доступа к личным подпискам
        </p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="All" style="color: #ef4444; font-size: 0.85rem; margin-bottom: 15px;"></div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; color: var(--accent-sage); margin-bottom: 6px; font-size: 0.85rem;">Email адрес</label>
                <input asp-for="Email" style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.4); border: 1px solid var(--glass-border); border-radius: 8px; color: #fff; outline: none;" placeholder="name@domain.com" />
                <span asp-validation-for="Email" style="color: #ef4444; font-size: 0.8rem;"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; color: var(--accent-sage); margin-bottom: 6px; font-size: 0.85rem;">Пароль</label>
                <input asp-for="Password" style="width: 100%; padding: 10px 14px; background: rgba(0,0,0,0.4); border: 1px solid var(--glass-border); border-radius: 8px; color: #fff; outline: none;" />
                <span asp-validation-for="Password" style="color: #ef4444; font-size: 0.8rem;"></span>
            </div>

            <div style="margin-bottom: 25px; display: flex; align-items: center; gap: 8px;">
                <input asp-for="RememberMe" style="accent-color: var(--neon-cyan);" />
                <label asp-for="RememberMe" style="color: var(--text-muted); font-size: 0.85rem; cursor: pointer;"></label>
            </div>

            <button type="submit" class="btn-futuristic" style="width: 100%; padding: 12px; font-size: 0.95rem; font-weight: bold;">
                Войти
            </button>
        </form>

        <hr style="border-color: var(--glass-border); margin: 25px 0;" />

        <p style="text-align: center; color: var(--text-muted); font-size: 0.85rem; margin: 0;">
            Еще нет аккаунта? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" style="color: var(--neon-cyan); text-decoration: none;">Зарегистрироваться</a>
        </p>
    </div>
</div>